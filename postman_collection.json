		{
			"name": "Orders",
			"item": [
				{
					"name": "Create Order",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 201 || pm.response.code === 200) {",
									"    var json = pm.response.json();",
									"    if (json.id) pm.collectionVariables.set('order_id', json.id);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"user_id\": 1,\n    \"product_id\": 1,\n    \"quantity\": 2,\n    \"total_price\": 199.98\n}"
						},
						"url": {
							"raw": "{{gateway_url}}/api/orders/",
							"host": ["{{gateway_url}}"],
							"path": ["api", "orders", ""]
						}
