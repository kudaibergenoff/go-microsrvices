								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"updated@example.com\",\n    \"name\": \"Updated Name\"\n}"
						},
						"url": {
							"raw": "{{gateway_url}}/api/users/me",
							"host": ["{{gateway_url}}"],
							"path": ["api", "users", "me"]
