		{
			"name": "Media",
			"item": [
				{
					"name": "Upload File",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200 || pm.response.code === 201) {",
									"    var json = pm.response.json();",
									"    if (json.key) pm.collectionVariables.set('media_key', json.key);",
