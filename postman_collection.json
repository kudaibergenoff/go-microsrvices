							"raw": "{{gateway_url}}/api/media/{{media_key}}?folder=uploads",
							"host": ["{{gateway_url}}"],
							"path": ["api", "media", "{{media_key}}"],
							"query": [
								{
									"key": "folder",
									"value": "uploads",
									"description": "Storage folder (optional)"
