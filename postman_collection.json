								"value": "Bearer {{token}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"old_password\": \"123456\",\n    \"new_password\": \"NewPassword123\"\n}"
						},
						"url": {
							"raw": "{{gateway_url}}/api/users/me/password",
							"host": ["{{gateway_url}}"],
							"path": ["api", "users", "me", "password"]
