							"host": ["{{gateway_url}}"],
							"path": ["api", "orders", ""],
							"query": [
								{
									"key": "user_id",
									"value": "1",
									"description": "User ID (required)"
								},
								{
									"key": "limit",
									"value": "20"
								},
								{
									"key": "offset",
									"value": "0"
