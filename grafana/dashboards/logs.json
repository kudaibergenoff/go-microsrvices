{
  "annotations": { "list": [] },
  "editable": true,
  "panels": [
    {
      "title": "All Service Logs",
      "type": "logs",
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 0 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "targets": [
        {
          "expr": "{service=~\"$service\"} |= \"$search\"",
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "wrapLogMessage": true
      }
    },
    {
      "title": "Error Logs",
      "type": "logs",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 12 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "targets": [
        {
          "expr": "{service=~\"$service\"} |~ \"(?i)(error|fatal|panic)\"",
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "wrapLogMessage": true
      }
    },
    {
      "title": "Log Volume by Service",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 22 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "lineWidth": 2, "fillOpacity": 20, "stacking": { "mode": "normal" } }
        }
      },
      "targets": [
        {
          "expr": "sum(rate({service=~\".+\"}[1m])) by (service)",
          "legendFormat": "{{service}}"
        }
      ]
    }
  ],
  "schemaVersion": 39,
  "tags": ["microservices", "logs"],
  "templating": {
    "list": [
      {
        "name": "DS_LOKI",
        "type": "datasource",
        "query": "loki",
        "current": { "text": "Loki", "value": "Loki" }
      },
      {
        "name": "service",
        "type": "custom",
        "query": "gateway,auth-service,user-service,kafka,keycloak,prometheus,grafana",
        "current": { "text": "All", "value": "$__all" },
        "includeAll": true,
        "allValue": ".+"
      },
      {
        "name": "search",
        "type": "textbox",
        "current": { "text": "", "value": "" }
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "title": "Service Logs",
  "uid": "service-logs"
}
